# WARETRACE 3D Warehouse Digital Twin Module — Environment Configuration
# Copy this file to .env.local for local development against a live WARETRACE FastAPI backend.

# Base URL for the WARETRACE REST API (default: /api/v1)
# When using Vite's dev proxy, keep /api/v1 and configure VITE_API_PROXY_TARGET in vite.config.ts
VITE_API_BASE_URL="/api/v1"

# Optional WebSocket URL for future real-time warehouse synchronization.
# Leave unset unless a verified WARETRACE WebSocket endpoint is deployed.
# Example: wss://api.waretrace.example.com/ws/warehouse
VITE_WAREHOUSE_WS_URL=""
